# Copy to .env and adjust for local development

# Postgres (warehouse)
POSTGRES_USER=conversion
POSTGRES_PASSWORD=changethis
POSTGRES_DB=conversion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka (Redpanda advertised external listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_EVENTS=ecommerce.events

# Redis (Feast online store)
REDIS_HOST=localhost
REDIS_PORT=6379
# Host publish for compose Redis; change if 6379 is already taken
# REDIS_PUBLISH_PORT=6380

# MLflow (file store on the project mount; set a URL if you run a tracking server)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Training gate used by the Airflow DAG (leave TRAIN_MAX_SESSIONS empty for full table)
CONVERSION_MIN_TEST_ROC_AUC=0.65
# TRAIN_MAX_SESSIONS=4000

# BentoML (bind 0.0.0.0 so Prometheus in Docker can scrape /metrics)
BENTOML_PORT=3000

# Observability (Grafana is 3002 so it does not collide with BentoML)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Event replay
REPLAY_EVENTS_PER_SECOND=20

# Airflow (batch training orchestration)
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=46BKJoQYlFDeTCdn1UdMwTx1EGnLaeDE5aDm9Yfg98=
